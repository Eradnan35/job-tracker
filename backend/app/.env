# Database
# SQLAlchemy 2.0 requires "postgresql://" not "postgres://"
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/job_tracker

# JWT — generate a strong SECRET_KEY before deploying to production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
